APP_NAME="Naafein International Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nafein_academy_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Object Storage (Linode / S3 bucket uploads)
LINODE_KEY=
LINODE_SECRET=
LINODE_REGION=ap-south-1
LINODE_BUCKET=team-x.ap-south-1.linodeobjects.com
LINODE_ENDPOINT=https://team-x.ap-south-1.linodeobjects.com

# SMS Gateway Configuration
SMS_API_KEY=
SMS_SENDER_ID=NAFEIN
